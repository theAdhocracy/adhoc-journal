---
import Menu from "@/components/Menu.astro";
import Redacted from "@/components/Redacted.astro";
import People from "@/fragments/People.astro";

const { data, auth = 0 } = Astro.props;
---

<aside>
	<time class="time-divider" datetime={`${data.date.html} ${data.date.time}`}>
		{data.date.time}
	</time>
	<span aria-label="Ate at:">🍔</span>
	<h2>{data.location.title}</h2>
	<p>{data.location.location?.location || data.location.title}</p>
	<People data={data.people} auth={auth} />
	<Menu data={data.menu} auth={auth} />
	{data.notes && <Redacted data={data.notes} auth={auth} />}
</aside>

<style>
	aside {
		max-width: 100dvw;
		padding: 1rem;
		text-align: center;
	}
</style>
