---
import People from "@/fragments/People.astro";

const { data, auth = 0 } = Astro.props;

// TODO: Work out how to display notes, talks etc. Own subsection of journal and a link? Details/disclosure element?
---

<aside>
	<time
		class="time-divider"
		datetime={`${data.duration.start.date} ${data.duration.start.time}`}
	>
		{data.duration.start.time}
	</time>
	<span>📅</span>
	<h2>{data.title}</h2>
	{
		!data.duration.isDate && (
			<time datetime={`${data.duration.end.date} ${data.duration.end.time}`}>
				{data.duration.end.time}
			</time>
		)
	}
	<p>{data.location.title}, {data.location.location?.location}</p>
	<People data={data.people} auth={auth} />
</aside>

<style>
	aside {
		padding: 1rem;
		text-align: center;

		time {
			--color: rebeccapurple;
		}
	}
</style>
