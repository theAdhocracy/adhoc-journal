---
import IconTravel from "@/components/IconTravel.astro";
import People from "@/fragments/People.astro";

const { data, auth = 0 } = Astro.props;

// TODO: Handle waypoints and add a map interface
// TODO: Handle "home" title (need to replace "0 - ")
---

<aside>
	<time class="time-divider" datetime={`${data.date.date} ${data.date.time}`}>
		{data.date.time}
	</time>
	<span aria-label="Travelled:" title="Travelled">🗺</span>
	<h2>
		{data.location.title}
		<span class="interstitial">to</span>
		{data.route[data.route.length - 1].location.title}
	</h2>
	<People data={data.people} auth={auth} />
	<ul role="list">
		<li>
			{data.location.title}
		</li>
		{
			data.route.map((stop: any, index: number) => {
				if (stop.key !== "location") return;

				return (
					<li role="listitem">
						<IconTravel type={stop.type} />
						{stop.location.title}
					</li>
				);
			})
		}
	</ul>
</aside>

<style>
	aside {
		padding: 1rem;
		text-align: center;

		time {
			--color: rgb(255, 208, 0);
		}

		ul {
			max-width: max-content;
			margin-block-start: 1rem;
			margin-inline: auto;
		}

		li[role="listitem"] {
			display: flex;
			gap: 1rem;
		}

		.interstitial {
			margin-inline-start: 0.1em;
			font-style: italic;
			font-size: var(--type-1);
		}
	}
</style>
