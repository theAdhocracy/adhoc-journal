---
import People from "@/fragments/People.astro";

const { data, auth = 0 } = Astro.props;
---

<aside>
	<time class="time-divider" datetime={`${data.date.date} ${data.date.time}`}>
		{data.date.time}
	</time>
	<span aria-label="Visited:">📍</span>
	<h2>
		<a href={`/journal/location/${data.location.slug}`}>{data.location.title}</a
		>
	</h2>
	<p>{data.location.location?.location || data.location.title}</p>
	<People data={data.people} auth={auth} />
</aside>

<style>
	aside {
		padding: 1rem;
		text-align: center;

		time {
			--color: rgb(255, 123, 0);
		}
	}
</style>
