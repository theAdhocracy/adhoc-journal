---
import Redacted from "@/components/Redacted.astro";
import { getStarRating } from "@/utils/content";

const { data, auth = 0 } = Astro.props;

const uid = Math.random().toString().replace("0.", "");
---

<div role="region" aria-labelledby={`caption_${uid}`} tabindex="0">
	<table>
		<caption id={`caption_${uid}`} class="visually-hidden"
			>Dishes that we ate.</caption
		>
		<thead class="visually-hidden">
			<tr>
				<th>Key</th>
				<th>Dish</th>
				<th>Rating</th>
				<th>Thoughts</th>
			</tr>
		</thead>
		<tbody>
			{
				data.map((dish: any) => {
					const rating = getStarRating(dish.rating);

					// Hide certain food if not authed
					if (dish.isAlison && auth < 2) return;

					return (
						<tr>
							<td>
								{dish.isShared && (
									<span class="label" aria-label="Shared" title="Shared">
										S
									</span>
								)}
								{dish.isAlison && (
									<span class="label" aria-label="Alison" title="Alison">
										A
									</span>
								)}
							</td>
							<td>{dish.title}</td>
							<td>
								{dish.rating && (
									<span aria-label={`${dish.rating} stars out of five.`}>
										{rating}
									</span>
								)}
							</td>
							<td>
								<Redacted data={dish.notes} auth={auth} />
							</td>
						</tr>
					);
				})
			}
		</tbody>
	</table>
</div>

<style>
	div[role="region"] {
		overflow: auto;
		margin-block-start: 1rem;
		padding-block: 1rem;

		&:focus {
			outline: 0.1em solid slategrey;
		}
	}

	table {
		min-width: 60ch;
		text-align: start;
		vertical-align: baseline;
	}

	td:nth-child(2) {
		min-width: 20ch;
	}

	td:nth-child(4) {
		min-width: 40ch;
		font-size: 0.8rem;
	}

	.label {
		display: flex;
		width: 1.2rem;
		aspect-ratio: 1 / 1;
		justify-content: center;
		margin-top: 0.25em;
		border: 1px solid slategray;
		border-radius: 50%;
		font-size: 0.8rem;
		line-height: 1.2;
	}
</style>
