---
const { data, auth } = Astro.props;
---

{
	data.length > 0 && (
		<p>
			with{" "}
			{auth === 2 &&
				data.map((person: any, index: number) => {
					return (
						<span>
							{index !== 0 && ", "}
							<a href={`/person/${person.slug}`}>{person.name}</a>
						</span>
					);
				})}
			{auth < 2 && ` ${data.length} people`}
		</p>
	)
}
