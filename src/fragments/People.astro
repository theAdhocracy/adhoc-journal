---
const { data, auth = 0, isInline = false } = Astro.props;

const Wrapper = isInline ? "span" : "p";
---

{
	data.length > 0 && (
		<Wrapper>
			with{" "}
			{auth === 2 &&
				data.map((person: any, index: number) => {
					return (
						<span>
							{index !== 0 && ", "}
							<a href={`/person/${person.slug}`}>{person.name}</a>
						</span>
					);
				})}
			{auth < 2 && ` ${data.length} people`}
		</Wrapper>
	)
}
