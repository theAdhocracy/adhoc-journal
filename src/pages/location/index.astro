---
import Layout from "@/layouts/Layout.astro";
import Map from "@/components/Map.astro";
import LineGraph from "@/components/LineGraph.astro";
import StatsList from "@/fragments/StatsList.astro";

// Fetch initial data
const countryAPI = await fetch(
	`https://cms.theadhocracy.co.uk/search/location.json?q=&l=&f=home OR country`,
	{
		method: "GET",
		headers: {
			"content-type": "application/json",
			Authorization: `Bearer ${import.meta.env.CRAFT_API_KEY}`,
		},
	}
);
const countries = await countryAPI.json();
const homeData = countries.data.splice(0, 1).pop();

// Split out current home to use as center point
const home = {
	...homeData,
	map: {
		lat: homeData.lat,
		long: homeData.long,
		zoom: homeData.zoom,
		uri: homeData.uri,
	},
};

// Fetch stats
const statsAPI = await fetch(
	`https://cms.theadhocracy.co.uk/stats/locations.json`,
	{
		method: "GET",
		headers: {
			"content-type": "application/json",
			Authorization: `Bearer ${import.meta.env.CRAFT_API_KEY}`,
		},
	}
);
const stats = await statsAPI.json();

// Graph: Y Axis
// NOTE: rounded up to the nearest 10
const yAxisLimit =
	Math.round(Math.max(...stats.graph.map((item: any) => item.checkins)) / 10) *
	10;
const yAxisGap = yAxisLimit / 3;

const yAxisLabels = Array.from({ length: 3 }, (_, index: number) => {
	const y = -100 + 35 * index;
	const label = Math.round(yAxisLimit - index * yAxisGap);

	return {
		y: y,
		label: label.toString(),
	};
});

// Graph: X Axis
const monthLetters = [
	"J",
	"F",
	"M",
	"A",
	"M",
	"J",
	"J",
	"A",
	"S",
	"O",
	"N",
	"D",
];

const xAxisLabels = stats.graph.map((datum: any, index: number) => {
	const month = datum.month.replace(/^[0-9]*-([0-9]*)-.*$/, "$1");
	const x = 40 + 20 * index;

	return {
		x: x,
		label: monthLetters[Number(month) - 1],
	};
});

// Graph: SVG path & labels
let checkinPath = "m 30 ";
const graphDataCoords = stats.graph.map((datum: any, index: number) => {
	// Path for graph line
	const x = 50 + index * 20;
	const y = (datum.checkins / yAxisLimit) * 100;
	checkinPath += `-${y} L ${x} -${y} L ${x} `;

	// Data label placement
	return {
		x: 40 + 20 * index,
		y: -y,
		label: datum.checkins,
	};
});

// Function: Search form
let searchData: any[] = [];
let topResult = null;
let query = "";
let location = "";
let filter = "";
let error = "";

if (Astro.request.method === "POST") {
	try {
		// Extract data from form
		const data = await Astro.request.formData();
		query = data.get("query")?.toString() || "";
		location = data.get("location")?.toString() || "";
		filter = data.get("filter")?.toString() || "";

		// Validate that some data has been requested
		if (!query && !filter && !location) {
			throw new Error("No data received");
		}

		// Build API query
		const searchQuery = `q=${query}&l=${location}&f=${filter}`;

		// Fetch search results
		const api = await fetch(
			`https://cms.theadhocracy.co.uk/search/location.json?${searchQuery}`,
			{
				method: "GET",
				headers: {
					"content-type": "application/json",
					Authorization: `Bearer ${import.meta.env.CRAFT_API_KEY}`,
				},
			}
		);
		const response = await api.json();
		searchData = response.data;
		topResult = searchData.shift();

		// Handle queries with no valid results
		if (!topResult) {
			error = "No locations match the search criteria.";
		}
	} catch (error) {
		if (error instanceof Error) {
			error = error.message;
		}
	}
}
---

<Layout title="Locations" hasMap hasTransitions>
	<main>
		<h1>Locations</h1>
		<section class="stats">
			<h2>Stats</h2>
			<p>All Time</p>
			<StatsList
				data={{
					total: stats.allTime.unique,
					countries: stats.allTime.countries,
					cities: stats.allTime.cities,
					pubs: stats.allTime.pubs,
					restaurants: stats.allTime.food,
					nature: stats.allTime.nature,
				}}
			/>
			<p>In {stats.year}</p>
			<StatsList
				data={{
					total: stats.currentYear.expanded,
					checkins: stats.currentYear.unique,
					countries: stats.currentYear.countries,
					cities: stats.currentYear.cities,
					pubs: stats.currentYear.pubs,
					restaurants: stats.currentYear.food,
					nature: stats.currentYear.nature,
				}}
			/>
			<p>Last 12 Months</p>
			<LineGraph
				title="Total visited locations per month (labelled as first letter)."
				lineTitle="Location total."
				linePath={checkinPath}
				xAxisLabels={xAxisLabels}
				yAxisLabels={yAxisLabels}
				datapoints={graphDataCoords}
			/>
		</section>
		<search role="search">
			<form method="POST">
				<h2>Search</h2>
				<label for="query">Find Location</label>
				<input type="text" id="query" name="query" value={query} />
				<label for="location">Restrict To Region</label>
				<input type="text" id="location" name="location" value={location} />
				<label for="filter">Filters:</label>
				<select name="filter" id="filter">
					<option value="">--Please choose an option--</option>
					<option value="park" selected={filter === "park"}>Park</option>
					<option value="nature" selected={filter === "nature"}>Nature</option>
					<option value="restaurant" selected={filter === "restaurant"}>
						Restaurant
					</option>
					<option value="pub" selected={filter === "pub"}>Pub</option>
				</select>
				<p class="loading">Loading...</p>
				{error && <p class="error">Error: {error}</p>}
				<button type="submit">Search</button>
			</form>
			{
				searchData.length > 0 && (
					<section class="results">
						<h2>Results</h2>
						<ul role="list">
							{searchData.map((result: any) => {
								// Makes search results filterable
								const hasLandmark = result.type.length > 0;

								return (
									<li
										class={
											hasLandmark ? `marker-${result.type[0]}` : "marker-child"
										}
									>
										<a href={`/journal/${result.uri}`}>{result.title}</a>
									</li>
								);
							})}
						</ul>
					</section>
				)
			}
		</search>
		{
			!topResult && (
				<>
					<Map
						data={home.map}
						title={home.title}
						children={countries.data}
						type={home.type[0]}
					/>
				</>
			)
		}
		{
			topResult && (
				<>
					<Map
						data={topResult}
						title={topResult.title}
						children={searchData}
						type={topResult.type[0]}
						hasFilters
						isSearchResults
					/>
				</>
			)
		}
	</main>
</Layout>

<script>
	// Function: Loading state for search form
	const loadingMsg = document.querySelector("search .loading");
	const button = document.querySelector("search button[type='submit']");

	button?.addEventListener("click", () => {
		loadingMsg?.classList.remove("loading");
	});

	document.addEventListener("astro:page-load", () => {
		loadingMsg?.classList.add("loading");
	});
</script>

<style>
	main {
		--gutters: max(1rem, 10dvw);
		--content: calc(100vw - (2 * var(--gutters)));
		--sidebar: calc(
			var(--content) / 2
		); /* how much of content should this fit (half) */

		display: grid;
		grid-template-columns:
			[full-start] var(--gutters)
			[overflow-start] minmax(0, 1fr)
			[content-start timeline-start] minmax(auto, 50rem)
			[timeline-end stats-start] min(var(--sidebar), 30rem)
			[stats-end content-end] minmax(0, 1fr)
			[overflow-end] var(--gutters)
			[full-end];
		gap: 1rem 0;
		padding-block-start: 1rem;

		& :global(> *) {
			grid-column: content;
		}

		& :global(#map) {
			grid-column: full;
			margin-block-start: 2rem;
		}

		@media (width >= 1000px) {
			& .stats {
				grid-column: stats;
				margin-inline-start: 1.5rem;
			}

			& search {
				grid-column: timeline;
				grid-row: 2;
				margin-inline-end: 1.5rem;
			}
		}
	}

	h2 {
		font-size: var(--type-0);
		font-family: var(--font-copy);
	}

	search {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		margin-block-start: 1rem;

		& form {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			max-width: 20rem;
			align-content: center;
			align-items: center;

			place-self: start;

			& h2 {
				width: 100%;
			}
		}

		& input {
			width: 100%;
		}

		& select {
			margin-inline-start: auto;
			flex-grow: 1;
		}

		& button {
			margin-inline-start: auto;
			padding: 0.25rem 1rem;
		}

		& input + label,
		& button,
		& select {
			margin-block-start: 0.5rem;
		}

		.results {
			flex: 1 1 14rem;

			& ul {
				padding-block-start: 0.5rem;
			}
		}
	}

	.stats {
		margin-block-start: 1rem;

		& > p {
			margin-block: 0.5rem 0.125rem;
		}
	}

	.loading {
		display: none;
	}
</style>
