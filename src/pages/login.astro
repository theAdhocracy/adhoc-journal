---
import Layout from "@/layouts/Layout.astro";

const params = new URLSearchParams(Astro.url.searchParams);
const referrer = params.get("path");

// Handle Form Logic
const validPassword1 = import.meta.env.AUTH_PASSWORD_1;
const validPassword2 = import.meta.env.AUTH_PASSWORD_2;
const validLevel1 = import.meta.env.AUTH_VALIDATION_1;
const validLevel2 = import.meta.env.AUTH_VALIDATION_2;
const errors = { password: "" };

if (Astro.request.method === "POST") {
	try {
		// Retrieve form data
		const data = await Astro.request.formData();
		const password = data.get("password");

		console.log(password);

		// Validate form data
		if (typeof password !== "string" || password.length < 10) {
			errors.password += "Password is invalid.";
		}

		// Validate password value
		let authLevel;
		if (password === validPassword1) {
			authLevel = validLevel1;
		} else if (password === validPassword2) {
			authLevel = validLevel2;
		} else {
			errors.password += "Password is invalid.";
		}

		// Check for validation failures
		const isInvalid = Object.values(errors).some((msg) => msg);

		// Confirm log in
		if (!isInvalid) {
			console.log("Valid attempt");
			// NOTE: 86400000 is a single day in ms, so this is 90 days
			const expirationDate = new Date(Date.now() + 86400000 * 90);

			Astro.cookies.set("auth", authLevel, {
				expires: expirationDate,
				sameSite: "strict",
				httpOnly: true,
				secure: true,
			});

			// Development environment fix (due to hosting at a subdirectory)
			const redirect = referrer?.replace(/^\/journal/, "");

			return !redirect
				? Astro.redirect(`/journal?`)
				: Astro.redirect(`/journal${redirect}?`);
		} else {
			console.log(errors);
			console.log(validPassword1);
			console.log(validPassword2);
			Astro.cookies.delete("auth");
		}
	} catch (error) {
		if (error instanceof Error) {
			console.error(error.message);
		}
	}
}
---

<Layout title="Log In" hasTransitions>
	<main>
		<h1>Please Log In</h1>
		<p>You need to log in to view these pages.</p>
		<form method="post">
			<label for="login_password">Password</label>
			<input
				type="password"
				id="login_password"
				name="password"
				required
				minlength="8"
			/>
			{errors.password && <p>{errors.password}</p>}
			<button type="submit">Log In</button>
		</form>
	</main>
</Layout>
